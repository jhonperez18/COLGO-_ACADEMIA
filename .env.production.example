# Copia como .env.production y completa con tu MySQL Aiven (opcional si usas API en Render).
# Luego: npm run vercel:env:production && npm run vercel:prod

# API pública con BD ya configurada (Render):
VITE_API_URL=https://colgo-academi-saas.onrender.com/api

FRONTEND_URL=https://colgo-academi-saas.vercel.app
CORS_ORIGIN=https://colgo-academi-saas.vercel.app,http://localhost:5173

# Si quieres que el backend de Vercel use Aiven directamente, descomenta y rellena:
