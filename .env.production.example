# Copia este archivo a .env.production y completa con Aiven (obligatorio para produccion).
# Luego: npm run setup:aiven
# Copia las mismas variables DB_* en Render - Environment.

VITE_API_URL=/api

FRONTEND_URL=https://project-bm9ko.vercel.app
CORS_ORIGIN=https://project-bm9ko.vercel.app,https://colgo-academi-saas.vercel.app,http://localhost:5173

# --- Aiven (producción) — pega UNA opción ---
# Opción 1: URI completa desde Aiven → Connection information
# DATABASE_URL=mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
# Opción 2: API token (console.aiven.io → User profile → API tokens)
# AIVEN_TOKEN=
# AIVEN_PROJECT=
# AIVEN_SERVICE=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true

JWT_SECRET=colgo-cambia-esta-clave-por-una-larga-y-unica
JWT_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_EMAIL=mario@colgo.edu
BOOTSTRAP_ADMIN_PASSWORD=123
